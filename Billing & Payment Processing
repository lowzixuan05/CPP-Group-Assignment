// ==================== 12. VALIDATION ====================
void validation() {
    int id;
    cout << "Enter Member ID to validate: ";
    cin >> id;

    int idx = findMemberIndexById(id);
    if (idx == -1) {
        cout << "INVALID: No member found with ID " << id << ".\n";
        return;
    }

    Member& m = members[idx];
    cout << "\n--------- VALIDATION RESULT ---------\n";
    cout << "Member ID:    " << m.id << "\n";
    cout << "Name:         " << m.name << "\n";
    cout << "Plan:         " << m.planName << "\n";
    cout << "Expiry Date:  " << m.expiryDate << "\n";
    cout << "Status:       " << (m.active ? "VALID / ACTIVE" : "INVALID / INACTIVE") << "\n";

    // check for any unpaid invoices
    bool hasUnpaid = false;
    for (int i = 0; i < invoiceCount; i++) {
        if (invoices[i].memberId == id && !invoices[i].paid) hasUnpaid = true;
    }
    cout << "Outstanding Dues: " << (hasUnpaid ? "YES - please clear pending invoices" : "None") << "\n";
    cout << "--------------------------------------\n";
}

