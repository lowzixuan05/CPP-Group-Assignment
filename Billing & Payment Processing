    int id;
    cout << "Enter Member ID: ";
    cin >> id;
    if (findMemberIndexById(id) == -1) { cout << "Member not found.\n"; return; }

    bool found = false;
    cout << left << setw(10) << "PayID" << setw(14) << "Category"
        << setw(12) << "Amount" << setw(16) << "Method" << setw(12) << "Date" << endl;
    cout << string(64, '-') << endl;

    for (int i = 0; i < paymentCount; i++) {
        if (payments[i].memberId == id) {
            found = true;
            cout << left << setw(10) << payments[i].paymentId
                << setw(14) << payments[i].category
                << setw(12) << fixed << setprecision(2) << payments[i].amount
                << setw(16) << payments[i].paymentType
