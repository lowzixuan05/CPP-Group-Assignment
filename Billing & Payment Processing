void printInvoice(const Invoice& inv) {
    cout << "\n--------- INVOICE GENERATED ---------\n";
    cout << "Invoice ID:   " << inv.invoiceId << "\n";
    cout << "Member ID:    " << inv.memberId << "\n";
    cout << "Type:         " << inv.type << "\n";
