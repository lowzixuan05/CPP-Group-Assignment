// ==================== 5-8. PAYMENT TYPES ====================
void payByType(const char type[]) {
    int id;
    cout << "Enter Member ID: ";
    cin >> id;
    if (findMemberIndexById(id) == -1) { cout << "Member not found.\n"; return; }

    int invIdx;
    if (!chooseUnpaidInvoice(id, invIdx)) return;

    if (strcmp(type, "E-Wallet") == 0) {
        cout << "\n[ Scan the QR code below with your e-wallet app ]\n";
        cout << "   #####  ####   #\n";
        cout << "   #   # #    #  #\n";
        cout << "   #####  ####   #\n";
        cout << "   (QR CODE PLACEHOLDER)\n\n";
    }

    finalizeInvoicePayment(invIdx, type);
}

// Records the Payment and marks the Invoice as paid.
void finalizeInvoicePayment(int invoiceIndex, const char paymentType[]) {
    if (paymentCount >= MAX_PAYMENTS) { cout << "Payment log full!\n"; return; }

    Invoice& inv = invoices[invoiceIndex];

    Payment p;
    p.paymentId = nextPaymentId++;
    p.memberId = inv.memberId;
    p.invoiceId = inv.invoiceId;
    safeCopy(p.category, sizeof(p.category), inv.type);
    p.amount = inv.totalCharged;
    safeCopy(p.paymentType, sizeof(p.paymentType), paymentType);
    safeCopy(p.date, sizeof(p.date), inv.date);

    payments[paymentCount++] = p;
    inv.paid = true;

    cout << fixed << setprecision(2);
    cout << "\nPayment successful! Payment ID: " << p.paymentId
        << " | Amount: " << CURRENCY << p.amount
        << " | Method: " << p.paymentType << "\n";
}

// ==================== 9 & 10. GENERATE RECEIPTS ====================
void generateReceiptByType(const char type[]) {
    int id;
    cout << "Enter Member ID: ";
    cin >> id;
    if (findMemberIndexById(id) == -1) { cout << "Member not found.\n"; return; }

    cout << "\nPaid " << type << " invoices awaiting receipt:\n";
    bool found = false;
    for (int i = 0; i < invoiceCount; i++) {
        if (invoices[i].memberId == id && invoices[i].paid &&
            !invoices[i].receiptGenerated && strcmp(invoices[i].type, type) == 0) {
            found = true;
            cout << "  Invoice #" << invoices[i].invoiceId
                << " - " << CURRENCY << fixed << setprecision(2) << invoices[i].totalCharged << "\n";
        }
    }
    if (!found) {
        cout << "No paid " << type << " invoices pending a receipt.\n";
        return;
    }

    int invId;
    cout << "Enter Invoice ID to generate receipt for: ";
    cin >> invId;

    int idx = findInvoiceIndexById(invId);
    if (idx == -1 || invoices[idx].memberId != id || !invoices[idx].paid ||
        invoices[idx].receiptGenerated || strcmp(invoices[idx].type, type) != 0) {
        cout << "Invalid selection.\n";
        return;
    }

    // find matching payment
    int payIdx = -1;
    for (int i = 0; i < paymentCount; i++) {
        if (payments[i].invoiceId == invId) { payIdx = i; break; }
    }
    if (payIdx == -1) { cout << "No matching payment record found.\n"; return; }

    if (receiptCount >= MAX_RECEIPTS) { cout << "Receipt log full!\n"; return; }

    Receipt r;
    r.receiptId = nextReceiptId++;
    r.paymentId = payments[payIdx].paymentId;
    r.invoiceId = invId;
    r.memberId = id;
    r.amount = invoices[idx].totalCharged;
    safeCopy(r.date, sizeof(r.date), invoices[idx].date);

    receipts[receiptCount++] = r;
    invoices[idx].receiptGenerated = true;

    printReceiptSlip(r);
}

void printReceiptSlip(const Receipt& r) {
    cout << fixed << setprecision(2);
    cout << "\n========= RECEIPT =========\n";
    cout << "Receipt ID:  " << r.receiptId << "\n";
    cout << "Payment ID:  " << r.paymentId << "\n";
    cout << "Invoice ID:  " << r.invoiceId << "\n";
    cout << "Member ID:   " << r.memberId << "\n";
    cout << "Amount:      " << CURRENCY << r.amount << "\n";
    cout << "Date:        " << r.date << "\n";
    cout << "============================\n";
}

