// ==================== HELPERS ====================
int findMemberIndexById(int id) {
    for (int i = 0; i < memberCount; i++)
        if (members[i].id == id) return i;
    return -1;
}

int findPlanIndex(const char planName[]) {
    for (int i = 0; i < NUM_PLANS; i++)
        if (strcmp(plans[i].name, planName) == 0) return i;
    return -1;
}

int findInvoiceIndexById(int id) {
    for (int i = 0; i < invoiceCount; i++)
        if (invoices[i].invoiceId == id) return i;
    return -1;
}

// Lists unpaid invoices for a member and lets the user pick one.
// Returns true and sets outInvoiceIndex if a valid selection was made.
bool chooseUnpaidInvoice(int memberId, int& outInvoiceIndex) {
    bool found = false;
    cout << "\nUnpaid invoices for Member ID " << memberId << ":\n";
    cout << left << setw(10) << "InvID" << setw(14) << "Type"
        << setw(10) << "RefID" << setw(12) << "Amount" << endl;
    cout << string(46, '-') << endl;

    for (int i = 0; i < invoiceCount; i++) {
        if (invoices[i].memberId == memberId && !invoices[i].paid) {
            found = true;
            cout << left << setw(10) << invoices[i].invoiceId
                << setw(14) << invoices[i].type
                << setw(10) << invoices[i].refId
                << setw(12) << fixed << setprecision(2) << invoices[i].totalCharged
                << endl;
        }
    }

    if (!found) {
        cout << "No unpaid invoices found for this member.\n";
        return false;
    }

    int invId;
    cout << "Enter Invoice ID to pay: ";
    cin >> invId;

    int idx = findInvoiceIndexById(invId);
    if (idx == -1 || invoices[idx].memberId != memberId || invoices[idx].paid) {
        cout << "Invalid invoice selection.\n";
        return false;
    }

    outInvoiceIndex = idx;
    return true;
}

bool choosePaymentType(char outType[]) {
    int c;
    cout << "Select Payment Type:\n";
    cout << "1. Cash\n2. E-Wallet (QR code)\n3. Credit Card\n4. Online Banking\n";
    cout << "Enter choice: ";
    cin >> c;

    switch (c) {
    case 1: safeCopy(outType, 20, "Cash"); return true;
    case 2: safeCopy(outType, 20, "E-Wallet"); return true;
    case 3: safeCopy(outType, 20, "Credit Card"); return true;
    case 4: safeCopy(outType, 20, "Online Banking"); return true;
    default: cout << "Invalid selection.\n"; return false;
    }
}

// ==================== 1. MEMBERSHIP REGISTRATION PAYMENT ====================
void registrationPayment() {
    if (memberCount >= MAX_MEMBERS) {
        cout << "Member list is full!\n";
        return;
    }

    Member m;
    m.id = nextMemberId++;

    cout << "Enter member name: ";
    cin.ignore();
    cin.getline(m.name, 50);

    cout << "Enter phone number: ";
    cin.getline(m.phone, 15);

    cout << "Available Plans:\n";
    for (int i = 0; i < NUM_PLANS; i++)
        cout << "  " << (i + 1) << ". " << plans[i].name
        << " - " << CURRENCY << plans[i].monthlyFee << "/month\n";

    int planChoice;
    cout << "Select plan (1-" << NUM_PLANS << "): ";
    cin >> planChoice;
    if (planChoice < 1 || planChoice > NUM_PLANS) planChoice = 1;

    safeCopy(m.planName, sizeof(m.planName), plans[planChoice - 1].name);
    m.monthlyFee = plans[planChoice - 1].monthlyFee;
    m.active = true;

    cout << "Enter join date (DD-MM-YYYY): ";
    cin >> m.joinDate;
    cout << "Enter membership expiry date (DD-MM-YYYY): ";
    cin >> m.expiryDate;

    members[memberCount++] = m;

    // Calculate total charged: base registration fee + first month's fee + tax
    double subtotal = REG_BASE_FEE + m.monthlyFee;
    double tax = subtotal * TAX_RATE;
    double total = subtotal + tax;

    Invoice inv;
    inv.invoiceId = nextInvoiceId++;
    inv.memberId = m.id;
    safeCopy(inv.type, sizeof(inv.type), "Registration");
    inv.refId = 0;
    inv.totalCharged = total;
    safeCopy(inv.date, sizeof(inv.date), m.joinDate);
    inv.paid = false;
    inv.receiptGenerated = false;
    invoices[invoiceCount++] = inv;

    cout << fixed << setprecision(2);
    cout << "\nMember registered! Member ID: " << m.id << "\n";
    cout << "Registration fee: " << CURRENCY << REG_BASE_FEE
        << " + first month (" << m.planName << "): " << CURRENCY << m.monthlyFee
        << " + tax: " << CURRENCY << tax << "\n";
    cout << "Total charged: " << CURRENCY << total << "\n";

    char payType[20];
    cout << "Proceed to payment now? (1=Yes, 0=No): ";
    int yn; cin >> yn;
    if (yn == 1 && choosePaymentType(payType)) {
        int idx = invoiceCount - 1; // the invoice just created
        finalizeInvoicePayment(idx, payType);
    }
    else {
        cout << "Payment deferred. Use Payment Type menu later to settle Invoice #"
            << inv.invoiceId << ".\n";
    }
}

// ==================== 2. RENEW MEMBERSHIP ====================
void renewMembership() {
    int id;
    cout << "Enter Member ID to renew: ";
    cin >> id;

    int idx = findMemberIndexById(id);
    if (idx == -1) {
        cout << "Member not found.\n";
        return;
    }

    Member& m = members[idx];
    cout << "Current plan: " << m.planName << " (" << CURRENCY << m.monthlyFee << "/month)\n";
    cout << "Current expiry: " << m.expiryDate << "\n";

    cout << "Enter new expiry date (DD-MM-YYYY): ";
    cin >> m.expiryDate;
    m.active = true;

    double subtotal = m.monthlyFee;
    int planIdx = findPlanIndex(m.planName);
    double discount = (planIdx != -1) ? subtotal * plans[planIdx].discountPercent / 100.0 : 0.0;
    double afterDiscount = subtotal - discount;
    double tax = afterDiscount * TAX_RATE;
    double total = afterDiscount + tax;

    Invoice inv;
    inv.invoiceId = nextInvoiceId++;
    inv.memberId = m.id;
    safeCopy(inv.type, sizeof(inv.type), "Renewal");
    inv.refId = 0;
    inv.totalCharged = total;
    safeCopy(inv.date, sizeof(inv.date), m.expiryDate);
    inv.paid = false;
    inv.receiptGenerated = false;
    invoices[invoiceCount++] = inv;

    cout << fixed << setprecision(2);
    cout << "Renewal fee: " << CURRENCY << subtotal << " - discount " << CURRENCY << discount
        << " + tax " << CURRENCY << tax << " = Total " << CURRENCY << total << "\n";

    char payType[20];
    cout << "Proceed to payment now? (1=Yes, 0=No): ";
    int yn; cin >> yn;
    if (yn == 1 && choosePaymentType(payType)) {
        finalizeInvoicePayment(invoiceCount - 1, payType);
    }
    else {
        cout << "Payment deferred. Use Payment Type menu later to settle Invoice #"
            << inv.invoiceId << ".\n";
    }
}

// ==================== 3 & 4. GENERATE INVOICES ====================
void generateInvoiceBooking() {
    if (bookingCount >= MAX_BOOKINGS) { cout << "Booking list full!\n"; return; }

    int id;
    cout << "Enter Member ID: ";
    cin >> id;
    if (findMemberIndexById(id) == -1) { cout << "Member not found.\n"; return; }

    Booking b;
    b.bookingId = nextBookingId++;
    b.memberId = id;

    cout << "Enter booking description (e.g., Yoga Class, Personal Training): ";
    cin.ignore();
    cin.getline(b.description, 50);

    cout << "Enter session amount (" << CURRENCY << "): ";
    cin >> b.amount;

    cout << "Enter booking date (DD-MM-YYYY): ";
    cin >> b.date;

    bookings[bookingCount++] = b;

    double tax = b.amount * TAX_RATE;
    double total = b.amount + tax;

    Invoice inv;
    inv.invoiceId = nextInvoiceId++;
    inv.memberId = id;
    safeCopy(inv.type, sizeof(inv.type), "Booking");
    inv.refId = b.bookingId;
    inv.totalCharged = total;
    safeCopy(inv.date, sizeof(inv.date), b.date);
    inv.paid = false;
    inv.receiptGenerated = false;
    invoices[invoiceCount++] = inv;

    cout << fixed << setprecision(2);
    printInvoice(inv);
}

