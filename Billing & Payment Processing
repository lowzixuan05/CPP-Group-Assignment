void staffSearchPayment() {
    int c;
    cout << "Search by: 1. Payment ID   2. Member ID\n";
    cout << "Enter choice: ";
    cin >> c;

    if (c == 1) {
        int pid;
        cout << "Enter Payment ID: ";
        cin >> pid;
        for (int i = 0; i < paymentCount; i++) {
            if (payments[i].paymentId == pid) {
                cout << fixed << setprecision(2);
                cout << "\nPayment ID: " << payments[i].paymentId
                    << "\nMember ID:  " << payments[i].memberId
                    << "\nCategory:   " << payments[i].category
                    << "\nAmount:     " << CURRENCY << payments[i].amount
                    << "\nMethod:     " << payments[i].paymentType
                    << "\nDate:       " << payments[i].date << "\n";
                return;
            }
        }
        cout << "Payment not found.\n";
    }
    else if (c == 2) {
        int mid;
        cout << "Enter Member ID: ";
        cin >> mid;
        bool found = false;
        for (int i = 0; i < paymentCount; i++) {
            if (payments[i].memberId == mid) {
                found = true;
                cout << fixed << setprecision(2);
                cout << "PayID " << payments[i].paymentId << " | "
                    << payments[i].category << " | " << CURRENCY << payments[i].amount
                    << " | " << payments[i].paymentType << " | " << payments[i].date << "\n";
            }
        }
        if (!found) cout << "No payments found for this member.\n";
    }
    else {
        cout << "Invalid choice.\n";
    }
}
