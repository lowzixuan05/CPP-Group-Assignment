#include <iostream>
#include <iomanip>
#include <cstring>

using namespace std;

void safeCopy(char* dest, size_t destSize, const char* src) {
#ifdef _MSC_VER
    strcpy_s(dest, destSize, src);
#else
    strncpy(dest, src, destSize - 1);
    dest[destSize - 1] = '\0';
#endif
}

// ==================== CONSTANTS ====================
const int MAX_MEMBERS = 100;
const int MAX_BOOKINGS = 100;
const int MAX_APPOINTMENTS = 100;
const int MAX_INVOICES = 200;
const int MAX_PAYMENTS = 300;
const int MAX_RECEIPTS = 300;
const int NUM_PLANS = 3;
const double TAX_RATE = 0.08;         // 8% tax
const double REG_BASE_FEE = 50.0;         // flat one-time registration fee
const char* CURRENCY = "RM ";

// ==================== STRUCTURES ====================
struct MembershipPlan {
    char name[20];
    double monthlyFee;
    double discountPercent;
};

struct Member {
    int id;
    char name[50];
    char phone[15];
    char planName[20];
    double monthlyFee;
    char joinDate[12];
    char expiryDate[12];
    bool active;
};

struct Booking {
    int bookingId;
    int memberId;
    char description[50];
    double amount;
    char date[12];
};

struct Appointment {
    int appointmentId;
    int memberId;
    char description[50];
    double amount;
    char date[12];
};

// type: "Registration", "Renewal", "Booking", "Appointment"
struct Invoice {
    int invoiceId;
    int memberId;
    char type[15];
    int refId;          // 0 for Registration/Renewal, else bookingId/appointmentId
    double totalCharged;
    char date[12];
    bool paid;
    bool receiptGenerated;
};

struct Payment {
    int paymentId;
    int memberId;
    int invoiceId;
    char category[15];      // Registration, Renewal, Booking, Appointment
    double amount;
    char paymentType[20];   // Cash, E-Wallet, Credit Card, Online Banking
    char date[12];
};

struct Receipt {
    int receiptId;
    int paymentId;
    int invoiceId;
    int memberId;
    double amount;
    char date[12];
};

// ==================== GLOBAL DATA ====================
MembershipPlan plans[NUM_PLANS] = {
    {"Basic",   70.0, 0.0},
    {"Premium", 100.0, 5.0},
    {"Elite",   150.0, 10.0}
};

Member       members[MAX_MEMBERS];       int memberCount = 0;
Booking      bookings[MAX_BOOKINGS];     int bookingCount = 0;
Appointment  appointments[MAX_APPOINTMENTS]; int appointmentCount = 0;
Invoice      invoices[MAX_INVOICES];     int invoiceCount = 0;
Payment      payments[MAX_PAYMENTS];     int paymentCount = 0;
Receipt      receipts[MAX_RECEIPTS];     int receiptCount = 0;

int nextMemberId = 1001;
int nextBookingId = 2001;
int nextAppointmentId = 3001;
int nextInvoiceId = 4001;
int nextPaymentId = 5001;
int nextReceiptId = 6001;

